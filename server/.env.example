# Copy to .env and change the secrets before deploying anywhere.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Use long random strings in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
