# Local dev: copy to server/.env. Not needed to just run `npm run dev` —
# every value here has a working default, and with no Redis credentials the
# store falls back to a local JSON file (server/data/db.json).

PORT=4000

# Comma-separated allowed origins. Leave unset when the API and web app share
# an origin (e.g. on Vercel). Only needed if you host them separately.
# CORS_ORIGIN=http://localhost:5173

# Use long random strings in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Upstash Redis (production store). On Vercel, adding the Upstash integration
# from the Marketplace injects these automatically. KV_REST_API_URL /
# KV_REST_API_TOKEN are also accepted.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
